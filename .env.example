# --- Shopee Affiliate Open API ---
SHOPEE_APP_ID=coloque_seu_app_id_aqui
SHOPEE_APP_SECRET=coloque_seu_secret_aqui
# Endpoint BR (troque o domínio se seu programa de afiliado for de outro país)
SHOPEE_API_URL=https://open-api.affiliate.shopee.com.br/graphql

# --- Telegram ---
TELEGRAM_BOT_TOKEN=coloque_o_token_do_botfather_aqui
# ID do grupo/canal (pode ser @nome_do_canal ou -100xxxxxxxxxx para grupos)
TELEGRAM_CHAT_ID=coloque_o_chat_id_aqui

# --- Configurações da busca ---
# Comissão mínima (0.10 = 10%) pra considerar a oferta "boa"
MIN_COMMISSION_RATE=0.10
# Quantos produtos buscar por ciclo
PRODUCTS_PER_FETCH=20
# Intervalo entre ciclos de busca, em minutos
FETCH_INTERVAL_MINUTES=30
